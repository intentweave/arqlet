{"id": "small-01", "graph": "small", "query": "MATCH (a)-[r:calls]->(b) RETURN a.id, b.id", "status": "supported", "ordered": false, "columns": ["a.id", "b.id"], "rows": [["a", "a"], ["a", "b"], ["a", "b"], ["b", "a"]], "note": "the unresolved edge is excluded; the self-loop and the parallel edge each count"}
{"id": "small-02", "graph": "small", "query": "MATCH (a)-[r:calls]->(a) RETURN r.id", "status": "supported", "ordered": false, "columns": ["r.id"], "rows": [["aa"]], "note": "a pattern that reuses a variable finds the self-loop"}
{"id": "small-03", "graph": "small", "query": "MATCH (n) WHERE n.parentId = 'root' RETURN n.label ORDER BY n.label", "status": "supported", "ordered": true, "columns": ["n.label"], "rows": [["Analyze"], ["Parse"]]}
{"id": "small-04", "graph": "small", "query": "MATCH (n:directory) RETURN count(n)", "status": "supported", "ordered": false, "columns": ["count(n)"], "rows": [[1]]}
{"id": "small-05", "graph": "small", "query": "MATCH (a)-[r:calls]-(b) RETURN count(*)", "status": "supported", "ordered": false, "columns": ["count(*)"], "rows": [[7]], "note": "undirected: the self-loop matches once, every other edge twice"}
{"id": "small-06", "graph": "small", "query": "MATCH ()-[r]->() RETURN count(r)", "status": "supported", "ordered": false, "columns": ["count(r)"], "rows": [[4]], "note": "five edges in the file, four resolved"}
{"id": "small-07", "graph": "small", "query": "MATCH (n) WHERE n.nope IS NULL RETURN count(n)", "status": "supported", "ordered": false, "columns": ["count(n)"], "rows": [[3]], "note": "a property the node does not have is null"}
{"id": "code-01", "graph": "layerweave-code", "query": "MATCH (n:function) RETURN count(n)", "status": "supported", "ordered": false, "columns": ["count(n)"], "rows": [[125]]}
{"id": "code-02", "graph": "layerweave-code", "query": "MATCH (a)-[r:calls]->(b) RETURN count(r)", "status": "supported", "ordered": false, "columns": ["count(r)"], "rows": [[227]]}
{"id": "code-03", "graph": "layerweave-code", "query": "MATCH (a)-[r]->(a) RETURN a.label ORDER BY a.label", "status": "supported", "ordered": true, "columns": ["a.label"], "rows": [["absolute"], ["parse"], ["place"], ["round"]], "note": "four self-loops of any kind"}
{"id": "code-04", "graph": "layerweave-code", "query": "MATCH (a)-[:calls]->(b)-[:calls]->(c) RETURN count(*)", "status": "supported", "ordered": false, "columns": ["count(*)"], "rows": [[363]], "note": "relationship uniqueness: the two edges of a path differ"}
{"id": "code-05", "graph": "layerweave-code", "query": "MATCH (a)-[:calls]->(b) RETURN a.label, count(b) AS n ORDER BY n DESC, a.label LIMIT 3", "status": "supported", "ordered": true, "columns": ["a.label", "n"], "rows": [["compute_once", 11], ["run", 10], ["route_channels_raw", 9]], "note": "groups by the label value: two nodes called `run` form one group of 10"}
{"id": "code-06", "graph": "layerweave-code", "query": "MATCH (a)-[:calls]->(b) RETURN a.id, count(b) AS n ORDER BY n DESC, a.id LIMIT 3", "status": "supported", "ordered": true, "columns": ["a.id", "n"], "rows": [["fn:crates/layout/src/lib.rs::compute_once", 11], ["fn:crates/routing/src/channel.rs::route_channels_raw", 9], ["fn:crates/runtime/src/lib.rs::dispatch", 8]], "note": "groups by node: the same query by id gives different leaders than by label"}
{"id": "code-07", "graph": "layerweave-code", "query": "MATCH (n) WHERE n.parentId IS NULL RETURN count(n)", "status": "supported", "ordered": false, "columns": ["count(n)"], "rows": [[8]]}
{"id": "code-08", "graph": "layerweave-code", "query": "MATCH (a:container)-[r:depends]->(b:container) RETURN count(r)", "status": "supported", "ordered": false, "columns": ["count(r)"], "rows": [[12]]}
{"id": "org-01", "graph": "org-chart", "query": "MATCH (a)-[r:`reports to`]->(b) RETURN count(r)", "status": "supported", "ordered": false, "columns": ["count(r)"], "rows": [[70]]}
{"id": "org-02", "graph": "org-chart", "query": "MATCH ()-[r:`dotted line`]->() RETURN count(r)", "status": "supported", "ordered": false, "columns": ["count(r)"], "rows": [[12]]}
{"id": "org-03", "graph": "org-chart", "query": "MATCH (p:person) RETURN count(p)", "status": "supported", "ordered": false, "columns": ["count(p)"], "rows": [[71]]}
{"id": "org-04", "graph": "org-chart", "query": "MATCH (a)-[:`reports to`]->(m) RETURN m.label, count(a) AS reports ORDER BY reports DESC, m.label LIMIT 3", "status": "supported", "ordered": true, "columns": ["m.label", "reports"], "rows": [["Lead 0.0", 11], ["Lead 0.1", 9], ["Lead 2.0", 8]]}
{"id": "net-01", "graph": "network-vlan", "query": "MATCH (n:host) RETURN count(n)", "status": "supported", "ordered": false, "columns": ["count(n)"], "rows": [[22]]}
{"id": "net-02", "graph": "network-vlan", "query": "MATCH (a)-[r:deny]->(b) RETURN a.label, b.label ORDER BY a.label, b.label", "status": "supported", "ordered": true, "columns": ["a.label", "b.label"], "rows": [["Firewall A", "access switch 30"], ["Firewall B", "access switch 30"]]}
{"id": "net-03", "graph": "network-vlan", "query": "MATCH (a)-[r:`wan backup`]->(b) RETURN count(r)", "status": "supported", "ordered": false, "columns": ["count(r)"], "rows": [[1]]}
{"id": "net-04", "graph": "network-vlan", "query": "MATCH (a:switch)-[r]-(b:switch) RETURN count(*)", "status": "supported", "ordered": false, "columns": ["count(*)"], "rows": [[22]], "note": "eleven switch-to-switch edges of different kinds, each matched in both directions"}
{"id": "net-05", "graph": "network-vlan", "query": "MATCH (f:firewall)-[r:allow|deny]->(s:switch) RETURN f.label, count(r) AS rules ORDER BY f.label", "status": "supported", "ordered": true, "columns": ["f.label", "rules"], "rows": [["Firewall A", 4], ["Firewall B", 4]], "note": "relationship type alternatives with a grouping"}
{"id": "reject-01", "graph": "small", "query": "MATCH p = shortestPath((a)-[*]-(b)) RETURN p", "status": "later", "error": "unsupported", "note": "decypher drops shortestPath (upstream #133); the syntax-tree guard must reject it"}
{"id": "reject-02", "graph": "small", "query": "MATCH (a)-[:calls]->{1,3}(b) RETURN b", "status": "later", "error": "unsupported", "note": "decypher lowers the quantifier to one hop (upstream #134)"}
{"id": "reject-03", "graph": "small", "query": "MATCH (n WHERE n.label = 'Parse') RETURN n", "status": "later", "error": "unsupported", "note": "decypher drops the WHERE inside the pattern (upstream #132)"}
{"id": "reject-04", "graph": "small", "query": "MATCH (a)((x)-[:calls]->(y)){2}(b) RETURN b", "status": "later", "error": "unsupported", "note": "decypher splits a quantified path pattern into three patterns (upstream #134)"}
{"id": "reject-05", "graph": "small", "query": "CREATE (n:function {label: 'x'})", "status": "rejected", "error": "unsupported", "note": "writes are outside the first release"}
{"id": "reject-06", "graph": "small", "query": "MATCH (n) DETACH DELETE n", "status": "rejected", "error": "unsupported"}
{"id": "reject-07", "graph": "small", "query": "CALL db.index.vector.queryNodes('emb', 5, $v) YIELD node, score RETURN node", "status": "rejected", "error": "unsupported", "note": "procedures other than the ones we define"}
{"id": "reject-08", "graph": "small", "query": "RETURN foo_bar(1) AS x", "status": "rejected", "error": "unsupported", "note": "decypher accepts unknown function names; our function table does not"}
{"id": "reject-09", "graph": "small", "query": "MATCH (n RETURN n", "status": "invalid", "error": "syntax"}
{"id": "spike-01", "graph": "spike", "payload": "spike", "query": "MATCH (n:Person) RETURN n.name", "status": "supported", "ordered": false, "columns": ["n.name"], "rows": [["Ann"], ["Bob"], ["Cid"], ["Dee"]]}
{"id": "spike-02", "graph": "spike", "payload": "spike", "query": "MATCH (a)-[r:KNOWS]->(b) RETURN a.name, b.name", "status": "supported", "ordered": false, "columns": ["a.name", "b.name"], "rows": [["Ann", "Bob"], ["Ann", "Bob"], ["Ann", "Cid"], ["Bob", "Cid"], ["Cid", "Ann"], ["Cid", "Cid"]], "note": "six edges, two of them parallel and one a self-loop"}
{"id": "spike-03", "graph": "spike", "payload": "spike", "query": "MATCH (a)-[r:KNOWS|FOLLOWS]-(b) RETURN count(*)", "status": "supported", "ordered": false, "columns": ["count(*)"], "rows": [[13]], "note": "13: six KNOWS edges and one FOLLOWS edge; the self-loop once"}
{"id": "spike-04", "graph": "spike", "payload": "spike", "query": "MATCH (a)-[:KNOWS*1..2]->(b) RETURN DISTINCT b.name", "status": "supported", "ordered": false, "columns": ["b.name"], "rows": [["Ann"], ["Bob"], ["Cid"]]}
{"id": "spike-05", "graph": "spike", "payload": "spike", "query": "MATCH (a)-[:KNOWS*2]->(b) RETURN count(*)", "status": "supported", "ordered": false, "columns": ["count(*)"], "rows": [[10]], "note": "10 paths of exactly two distinct edges"}
{"id": "spike-06", "graph": "spike", "payload": "spike", "query": "MATCH (a)-[r1:KNOWS]->(b)<-[r2:KNOWS]-(c) RETURN count(*)", "status": "supported", "ordered": false, "columns": ["count(*)"], "rows": [[8]], "note": "8: r1 and r2 are different edges"}
{"id": "spike-07", "graph": "spike", "payload": "spike", "query": "MATCH (a:Person) OPTIONAL MATCH (a)-[:FOLLOWS]->(b) RETURN a.name, b.name", "status": "supported", "ordered": false, "columns": ["a.name", "b.name"], "rows": [["Ann", null], ["Bob", null], ["Cid", null], ["Dee", "Ann"]], "note": "three rows with null, one with Ann"}
{"id": "spike-08", "graph": "spike", "payload": "spike", "query": "MATCH (a)-[:KNOWS]->(b) WITH a, count(b) AS c WHERE c > 1 RETURN a.name, c", "status": "supported", "ordered": false, "columns": ["a.name", "c"], "rows": [["Ann", 3], ["Cid", 2]]}
{"id": "spike-09", "graph": "spike", "payload": "spike", "query": "MATCH (n:Person) WHERE n.nick IS NULL RETURN n.name", "status": "supported", "ordered": false, "columns": ["n.name"], "rows": [["Ann"], ["Bob"], ["Cid"], ["Dee"]]}
{"id": "spike-10", "graph": "spike", "payload": "spike", "query": "MATCH (n:Person) WHERE n.nick = 'x' RETURN n.name", "status": "supported", "ordered": false, "columns": ["n.name"], "rows": [], "note": "comparing null gives null, which filters the row out"}
{"id": "spike-11", "graph": "spike", "payload": "spike", "query": "MATCH (n:Person) WHERE n.name STARTS WITH 'A' OR n.name =~ 'B.*' RETURN n.name", "status": "later", "ordered": false, "columns": ["n.name"], "rows": [["Ann"], ["Bob"]], "error": "unsupported", "note": "`=~` is in ADR 0021's Later column: Cypher's regular expressions are Java's, and `arqlet-query` has no third-party dependency"}
{"id": "spike-20", "graph": "spike", "payload": "spike", "query": "MATCH (n:Person) WHERE n.name STARTS WITH 'A' OR n.name ENDS WITH 'b' OR n.name CONTAINS 'i' RETURN n.name", "status": "supported", "ordered": false, "columns": ["n.name"], "rows": [["Ann"], ["Bob"], ["Cid"]], "note": "the string operators that stay in the first release: Ann starts with A, Bob ends with b, Cid contains i"}
{"id": "spike-12", "graph": "spike", "payload": "spike", "query": "MATCH (a:Person) WHERE EXISTS { MATCH (a)-[:KNOWS]->(b) WHERE b.age > 35 } RETURN a.name", "status": "later", "ordered": false, "columns": ["a.name"], "rows": [["Ann"], ["Bob"], ["Cid"]], "error": "unsupported"}
{"id": "spike-13", "graph": "spike", "payload": "spike", "query": "UNWIND [1, 2, 3] AS x RETURN x * 2", "status": "supported", "ordered": false, "columns": ["x * 2"], "rows": [[2], [4], [6]]}
{"id": "spike-14", "graph": "spike", "payload": "spike", "query": "MATCH (n:Person) RETURN n.name ORDER BY n.age DESC SKIP 1 LIMIT 2", "status": "supported", "ordered": true, "columns": ["n.name"], "rows": [["Ann"], ["Bob"]]}
{"id": "spike-15", "graph": "spike", "payload": "spike", "query": "MATCH p = shortestPath((a:Person {name: 'Dee'})-[*]->(b:Person {name: 'Bob'})) RETURN length(p)", "status": "later", "ordered": false, "columns": ["length(p)"], "rows": [[2]], "error": "unsupported", "note": "Dee -> Ann -> Bob"}
{"id": "spike-16", "graph": "spike", "payload": "spike", "query": "MATCH (a:Person {name: 'Ann'}) RETURN size([(a)-[:KNOWS]->(b) | b.name])", "status": "open", "ordered": false, "columns": ["size([(a)-[:KNOWS]->(b) | b.name])"], "rows": [[3]], "note": "pattern comprehension is not in the ADR's subset table"}
{"id": "spike-17", "graph": "spike", "payload": "spike", "query": "MATCH (n:Person) RETURN CASE WHEN n.age < 18 THEN 'minor' ELSE 'adult' END AS g ORDER BY g", "status": "supported", "ordered": true, "columns": ["g"], "rows": [["adult"], ["adult"], ["adult"], ["minor"]]}
{"id": "spike-18", "graph": "spike", "payload": "spike", "query": "MATCH ()-[r:KNOWS {since: 2020}]->() RETURN r.id", "status": "supported", "ordered": false, "columns": ["r.id"], "rows": [["e2"]], "note": "a payload property on an edge, used in the pattern"}
{"id": "spike-19", "graph": "spike", "payload": "spike", "query": "MATCH (n:Person) RETURN n.nick", "status": "supported", "ordered": false, "columns": ["n.nick"], "rows": [[null], [null], [null], [null]], "note": "null as an output value"}
