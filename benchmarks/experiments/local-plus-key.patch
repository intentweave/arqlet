+/// Channel-engine candidate for moved leaves: the edges at a moved leaf and the routes that cross its old or new
+/// rectangle are routed again; every other route keeps its points. The candidate is a complete route set, finished and
+/// checked like any other, so the caller's comparison is unchanged.
+fn local_channel_candidate(
+    base: &Snapshot,
+    boxes: &BTreeMap<String, Rect>,
+    moved: &[&str],
+) -> Option<Snapshot> {
+    let graph = &base.graph;
+    let old = absolute_all(graph, &base.boxes);
+    let new = absolute_all(graph, boxes);
+    let mut changed: BTreeSet<String> = graph
+        .edges
+        .iter()
+        .filter(|e| {
+            e.target.is_some()
+                && moved
+                    .iter()
+                    .any(|m| e.source == *m || e.target.as_deref() == Some(*m))
+        })
+        .map(|e| e.id.clone())
+        .collect();
+    for route in &base.routes {
+        if moved.iter().any(|m| {
+            arqlet_routing::hits(route, &old[*m]) || arqlet_routing::hits(route, &new[*m])
+        }) {
+            changed.insert(route.id.clone());
+        }
+    }
+    let fixed: BTreeMap<String, Vec<Point>> = base
+        .routes
+        .iter()
+        .filter(|r| r.bundle_of.is_none())
+        .map(|r| (r.id.clone(), r.points.clone()))
+        .collect();
+    let (ends, margin) = channel_ends(graph, boxes, &base.options);
+    let subset = arqlet_routing::channel::Subset {
+        fixed: &fixed,
+        changed: &changed,
+    };
+    let Some(routes) = arqlet_routing::channel::route_channel_subset(
+        graph,
+        &new,
+        &ends,
+        margin,
+        base.options.track_spacing,
+        &subset,
+    ) else {
+        return assemble(base, boxes);
+    };
+    let mut candidate = base.clone();
+    candidate.boxes = boxes.clone();
+    candidate.routes = routes;
+    finish_routes(&mut candidate, true);
+    candidate.geometry_issues = arqlet_scene::validate_geometry(
+        graph,
+        boxes,
+        arqlet_scene::GeometryRules::default(),
+    );
+    candidate.layout_version = base.layout_version + 1;
+    labels::decorate(&mut candidate);
+    Some(candidate)
+}
