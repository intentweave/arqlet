+/// Routes that are kept: edge id to its points. Only the edges in `changed` are routed again.
+pub struct Subset<'a> {
+    pub fixed: &'a BTreeMap<String, Vec<Point>>,
+    pub changed: &'a BTreeSet<String>,
+}
+
+impl Subset<'_> {
+    /// An edge keeps its points unless it is changed; an edge without fixed points is always routed.
+    fn keeps(&self, edge_id: &str) -> bool {
+        self.fixed.contains_key(edge_id) && !self.changed.contains(edge_id)
+    }
+}
