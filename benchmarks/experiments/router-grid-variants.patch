+use arqlet_routing::proto::*;
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let text = std::fs::read_to_string(&args[1]).unwrap();
+    let all = parse(&text);
+    // A problem repeated with the same geometry (repeated repair passes) is counted once.
+    let mut seen = std::collections::BTreeSet::new();
+    let problems: Vec<&Problem> = all
+        .iter()
+        .filter(|p| seen.insert(format!("{} {:?} {:?} {}", p.id, p.route.points, p.obstacles.iter().map(|o| o.bounds().x).collect::<Vec<_>>(), p.obstacles.len())))
+        .collect();
+    let window_ok = problems.iter().filter(|p| p.window_found).count();
+    let window_ms: u128 = problems.iter().map(|p| p.window_ns).sum::<u128>() / 1_000_000;
+    println!("problems {} (all {}) windowFound {} windowMs {}", problems.len(), all.len(), window_ok, window_ms);
+    let variants: Vec<String> = args[2].split(',').map(String::from).collect();
+    let mut full_found: Vec<bool> = vec![];
+    for v in &variants {
+        let mut found = 0;
+        let mut gave = 0; // problems the windows gave up on
+        let (mut pops, mut cells, mut len, mut bends, mut ms_fail) = (0usize, 0usize, 0f64, 0usize, 0f64);
+        let started = std::time::Instant::now();
+        let mut ok = vec![];
+        for p in &problems {
+            let t = std::time::Instant::now();
+            let f = run(p, v);
+            pops += f.pops;
+            cells += f.cells;
+            let good = !f.points.is_empty();
+            ok.push(good);
+            if good {
+                assert!(is_free(p, &f.points[..]), "{v} {}: not free", p.id);
+                assert!(f.points.windows(2).all(|w| (w[0].x - w[1].x).abs() < 1e-6 || (w[0].y - w[1].y).abs() < 1e-6), "{v} {}: oblique", p.id);
+                found += 1;
+                if !p.window_found { gave += 1; }
+                len += f.points.windows(2).map(|w| (w[0].x - w[1].x).abs() + (w[0].y - w[1].y).abs()).sum::<f64>();
+                bends += f.points.len() - 2;
+            } else {
+                ms_fail += t.elapsed().as_secs_f64() * 1000.;
+            }
+        }
+        if v == "full" { full_found = ok.clone(); }
+        let (mut missed, mut extra) = (0, 0);
+        if !full_found.is_empty() {
+            missed = ok.iter().zip(&full_found).filter(|(a, b)| !**a && **b).count();
+            extra = ok.iter().zip(&full_found).filter(|(a, b)| **a && !**b).count();
+        }
+        println!(
+            "{v:12} found {found:5} (beyondWindows {gave:5}) missedVsFull {missed} extraVsFull {extra} ms {:8.1} failMs {ms_fail:8.1} pops {pops} meanCells {} len {:.0} bends {:.2}",
+            started.elapsed().as_secs_f64() * 1000.,
+            cells / problems.len().max(1),
+            len / found.max(1) as f64,
+            bends as f64 / found.max(1) as f64
+        );
+    }
+}
