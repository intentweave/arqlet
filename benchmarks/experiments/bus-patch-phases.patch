@@ -0,0 +1,44 @@
+//! Temporary (#212, benchmarks/experiments/bus-patch-phases.patch): nested wall-clock probes, printed by `layout-command`
+//! as `PHASE path ms count` lines. Not part of the engine.
+use std::cell::RefCell;
+use std::collections::BTreeMap;
+
+thread_local! {
+    static STACK: RefCell<Vec<&'static str>> = const { RefCell::new(Vec::new()) };
+    static SPENT: RefCell<BTreeMap<String, (f64, u64)>> = const { RefCell::new(BTreeMap::new()) };
+}
+
+/// Runs `f` and adds its time to the path of the probes around it plus `name`.
+pub fn time<T>(name: &'static str, f: impl FnOnce() -> T) -> T {
+    STACK.with(|s| s.borrow_mut().push(name));
+    let key = STACK.with(|s| s.borrow().join("/"));
+    let start = std::time::Instant::now();
+    let out = f();
+    let ms = start.elapsed().as_secs_f64() * 1e3;
+    STACK.with(|s| s.borrow_mut().pop());
+    SPENT.with(|m| {
+        let mut m = m.borrow_mut();
+        let e = m.entry(key).or_insert((0., 0));
+        e.0 += ms;
+        e.1 += 1;
+    });
+    out
+}
+
+/// Adds a count without time (for example a pass reason).
+pub fn count(name: &str, n: u64) {
+    SPENT.with(|m| {
+        let mut m = m.borrow_mut();
+        let e = m.entry(format!("#{name}")).or_insert((0., 0));
+        e.1 += n;
+    });
+}
+
+/// Prints and clears what was collected.
+pub fn print() {
+    SPENT.with(|m| {
+        for (k, (ms, n)) in std::mem::take(&mut *m.borrow_mut()) {
+            eprintln!("PHASE {k} {ms:.1} {n}");
+        }
+    });
+}
