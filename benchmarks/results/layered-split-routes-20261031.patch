+/// The route of an edge built in pieces (step 6): each piece is searched like a whole edge, kept apart from the routes
+/// built, and must stay inside its container; `None` when a piece fails (the routes of its earlier pieces are taken back).
+fn build_split(
+    p: &Prepared,
+    pieces: &[Piece],
+    assigned: &mut Vec<Segment>,
+    spacing: Spacing,
+) -> Option<(Route, usize)> {
+    let before = assigned.len();
+    let mut points: Vec<Point> = Vec::new();
+    let mut changes = 0;
+    for piece in pieces {
+        let part = Prepared {
+            edge_id: p.edge_id.clone(),
+            from_node: p.from_node.clone(),
+            to_node: p.to_node.clone(),
+            reversed: false,
+            vertical: p.vertical,
+            from: piece.from,
+            to: piece.to,
+            band: (
+                piece.band.0
+                    + if piece.margins.0 {
+                        spacing.margin
+                    } else {
+                        spacing.track
+                    },
+                piece.band.1
+                    - if piece.margins.1 {
+                        spacing.margin
+                    } else {
+                        spacing.track
+                    },
+            ),
+            obstacles: p.obstacles.clone(),
+            start: to_point(p.vertical, piece.from),
+            end: to_point(p.vertical, piece.to),
+        };
+        let built = (part.band.1 > part.band.0 + EPS && part.to.0 > part.from.0 + EPS)
+            .then(|| build_edge(&part, assigned, spacing.track, &Desired::new()).ok())
+            .flatten()
+            .filter(|(route, _)| {
+                piece.inside.as_ref().is_none_or(|r| {
+                    route.points.iter().all(|q| {
+                        q.x >= r.x - EPS
+                            && q.x <= r.x + r.width + EPS
+                            && q.y >= r.y - EPS
+                            && q.y <= r.y + r.height + EPS
+                    })
+                })
+            });
+        let Some((route, n)) = built else {
+            assigned.truncate(before);
+            return None;
+        };
+        changes += n;
+        let skip = usize::from(!points.is_empty());
+        points.extend(route.points.into_iter().skip(skip));
+    }
+    Some((Route::new(p.edge_id.as_str(), straighten(points)), changes))
+}
