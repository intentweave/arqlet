+/// One piece of an edge routed separately per area (step 6): from `from` to `to` (points in the flow's frame), searched in the
+/// band from `band.0` to `band.1` along the flow, and kept inside `inside` (the container it runs in) when given.
+#[derive(Clone, Debug)]
+struct Piece {
+    from: (f64, f64),
+    to: (f64, f64),
+    band: (f64, f64),
+    inside: Option<Rect>,
+    /// The margin the band keeps from its ends: the routing margin from a node, a track from a border point (the borders of
+    /// nested containers lie closer together than two margins).
+    margins: (bool, bool),
+}
+
+/// The pieces of the edges that cross the borders of containers with border nodes (plan section 4a, step 6): from the start
+/// port to the border point of each container it leaves, through the common area, and from the border point of each
+/// container it enters to the end port. A border point lies on the container's border, on the lane of the edge's border
+/// node. Backward edges and edges without such containers get none.
+fn split_pieces(
+    graph: &Graph,
+    boxes: &BTreeMap<String, Rect>,
+    prepared: &[(usize, Result<Prepared, Delegation>)],
+    plans: &LayeredPlans,
+) -> BTreeMap<usize, Vec<Piece>> {
+    let parent: BTreeMap<&str, &str> = graph
+        .nodes
+        .iter()
+        .map(|n| (n.id.as_str(), n.parent_id.as_deref().unwrap_or("<root>")))
+        .collect();
+    let mut out = BTreeMap::new();
+    for (slot, (index, outcome)) in prepared.iter().enumerate() {
+        let Ok(p) = outcome else { continue };
+        if p.reversed {
+            continue;
+        }
+        let edge = &graph.edges[*index];
+        let Some(target) = edge.target.as_deref() else {
+            continue;
+        };
+        let main = |r: &Rect| {
+            if p.vertical {
+                (r.y, r.y + r.height)
+            } else {
+                (r.x, r.x + r.width)
+            }
+        };
+        // The border point of `area` for this edge: on its far border when leaving, its near border when entering.
+        let border_point = |area: &str, leaving: bool| -> Option<((f64, f64), Rect)> {
+            let plan = plans.get(area)?;
+            let node = plan.borders.get(&edge.id)?;
+            let d = plan.dummies.get(node)?;
+            let r = boxes.get(area)?;
+            let across = if p.vertical {
+                r.x + d.x + d.width / 2.
+            } else {
+                r.y + d.y + d.height / 2.
+            };
+            let (near, far) = main(r);
+            Some(((if leaving { far } else { near }, across), r.clone()))
+        };
+        // The containers from an end up to (not including) the smallest area that holds both ends.
+        let ancestors = |id: &str| -> Vec<String> {
+            let mut out = Vec::new();
+            let mut at = parent.get(id).copied();
+            while let Some(a) = at {
+                out.push(a.to_string());
+                if a == "<root>" {
+                    break;
+                }
+                at = parent.get(a).copied();
+            }
+            out
+        };
+        let (up, down) = (ancestors(&edge.source), ancestors(target));
+        let Some(common) = up.iter().find(|a| down.contains(a)).cloned() else {
+            continue;
+        };
+        let leaving: Vec<&String> = up.iter().take_while(|a| **a != common).collect();
+        let entering: Vec<&String> = down.iter().take_while(|a| **a != common).collect();
+        if leaving.is_empty() && entering.is_empty() {
+            continue;
+        }
+        // The waypoints in order: the start port, the border point of every container left (inner first), of every
+        // container entered (outer first), and the end port; each with the container a piece must stay in.
+        let mut points: Vec<(f64, f64)> = vec![p.from];
+        let mut inside: Vec<Option<Rect>> = Vec::new();
+        let mut complete = true;
+        for area in &leaving {
+            match border_point(area, true) {
+                Some((point, rect)) => {
+                    points.push(point);
+                    // The piece that ends here runs inside the container it leaves.
+                    inside.push(Some(rect));
+                }
+                None => complete = false,
+            }
+        }
+        // The piece through the common area.
+        inside.push(None);
+        for area in entering.iter().rev() {
+            match border_point(area, false) {
+                Some((point, rect)) => {
+                    points.push(point);
+                    // The piece that starts here runs inside the container it enters.
+                    inside.push(Some(rect));
+                }
+                None => complete = false,
+            }
+        }
+        points.push(p.to);
+        if !complete || inside.len() != points.len() - 1 {
+            continue;
+        }
+        let last = points.len() - 2;
+        let pieces: Vec<Piece> = points
+            .windows(2)
+            .zip(inside)
+            .enumerate()
+            .map(|(k, (w, inside))| Piece {
+                from: w[0],
+                to: w[1],
+                band: (w[0].0, w[1].0),
+                inside,
+                margins: (k == 0, k == last),
+            })
+            .collect();
+        out.insert(slot, pieces);
+    }
+    out
+}
