+/// The order of the lane changes in one corridor that crosses least. A change is (lane before, lane after); when change `a`
+/// lies before `b` along the flow, `a`'s outgoing lane crosses `b`'s change if it lies inside `b`'s span, and `b`'s incoming
+/// lane crosses `a`'s change if it lies inside `a`'s span. Neighbours are swapped while a swap lowers the crossings (greedy
+/// switch), starting from the order of the lanes' midpoints.
+fn corridor_order(changes: &[(f64, f64)]) -> Vec<usize> {
+    let inside = |v: f64, (a, b): (f64, f64)| v > a.min(b) + EPS && v < a.max(b) - EPS;
+    let cost =
+        |a: (f64, f64), b: (f64, f64)| usize::from(inside(a.1, b)) + usize::from(inside(b.0, a));
+    let mut order: Vec<usize> = (0..changes.len()).collect();
+    order.sort_by(|&i, &j| {
+        let (a, b) = (changes[i], changes[j]);
+        (a.0 + a.1).total_cmp(&(b.0 + b.1)).then(i.cmp(&j))
+    });
+    let mut improved = true;
+    let mut rounds = 0;
+    while improved && rounds < changes.len() * changes.len() + 1 {
+        improved = false;
+        rounds += 1;
+        for k in 0..order.len().saturating_sub(1) {
+            let (a, b) = (changes[order[k]], changes[order[k + 1]]);
+            if cost(b, a) < cost(a, b) {
+                order.swap(k, k + 1);
+                improved = true;
+            }
+        }
+    }
+    order
+}
