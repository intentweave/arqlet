+/// The tracks beside a node on which the routes to its ports across the flow meet the ports' heights (plan section 4a, step
+/// 6). The stubs of one side of a node (and of the nodes in line with it on the same flow coordinate) take a track each,
+/// a track apart: at a route's end, the stub later in the flow takes the track farther from the node, so that the route
+/// coming down to it passes outside the earlier stubs; at its start, the stub earlier in the flow takes the farther track.
+fn approach_tracks(
+    mut prepared: Vec<(usize, Result<Prepared, Delegation>)>,
+    track: f64,
+) -> Vec<(usize, Result<Prepared, Delegation>)> {
+    // By (vertical, at the end, side's cross coordinate, direction), the slots with their port's flow coordinate.
+    let mut groups: BTreeMap<(bool, bool, i64, i64), Vec<(usize, f64)>> = BTreeMap::new();
+    for (slot, (_, outcome)) in prepared.iter().enumerate() {
+        let Ok(p) = outcome else { continue };
+        for (at_end, port) in [(false, &p.start_port), (true, &p.end_port)] {
+            if let Some((point, away)) = port {
+                let (main, across) = frame(p.vertical, point);
+                groups
+                    .entry((
+                        p.vertical,
+                        at_end,
+                        (across * 2.).round() as i64,
+                        *away as i64,
+                    ))
+                    .or_default()
+                    .push((slot, main));
+            }
+        }
+    }
+    for ((_, at_end, _, _), mut members) in groups {
+        // Farthest first: the latest at an end, the earliest at a start.
+        members.sort_by(|a, b| {
+            let order = a.1.total_cmp(&b.1);
+            (if at_end { order.reverse() } else { order }).then(a.0.cmp(&b.0))
+        });
+        let count = members.len();
+        for (place, (slot, _)) in members.into_iter().enumerate() {
+            let Ok(p) = prepared[slot].1.as_mut() else {
+                continue;
+            };
+            let extra = (count - 1 - place) as f64 * track;
+            if at_end {
+                let away = p.end_port.as_ref().map_or(0., |(_, d)| *d);
+                p.to.1 += away * extra;
+                p.end = to_point(p.vertical, p.to);
+            } else {
+                let away = p.start_port.as_ref().map_or(0., |(_, d)| *d);
+                p.from.1 += away * extra;
+                p.start = to_point(p.vertical, p.from);
+            }
+        }
+    }
+    prepared
+}
