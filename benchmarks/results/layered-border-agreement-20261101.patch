+/// The border agreement (plan section 4a, step 6): for every container with border nodes, by border node, the place where
+/// its edge goes on in the parent's plan: the position (relative, within its rank) of the element next to the container on
+/// the edge's chain there, and, for edges that share that element, the place of the edge at the next container's border.
+/// `parent_of` gives every node's area (`"<root>"` for the top level).
+pub fn outside_border_keys(
+    plans: &LayeredPlans,
+    parent_of: &BTreeMap<String, String>,
+    edges: &BTreeMap<String, (String, String)>,
+) -> BTreeMap<String, BTreeMap<String, f64>> {
+    let relative = |plan: &AreaPlan, id: &str| -> Option<f64> {
+        plan.ranks.iter().find_map(|rank| {
+            rank.iter()
+                .position(|x| x == id)
+                .map(|i| (i as f64 + 0.5) / rank.len() as f64)
+        })
+    };
+    // The child of `area` that holds `node` (or the node itself), if any.
+    let child_in = |area: &str, node: &str| -> Option<String> {
+        let mut at = node.to_string();
+        loop {
+            let up = parent_of.get(&at)?;
+            if up == area {
+                return Some(at);
+            }
+            at = up.clone();
+        }
+    };
+    let mut out = BTreeMap::new();
+    for (area, plan) in plans {
+        if plan.borders.is_empty() || area == "<root>" {
+            continue;
+        }
+        let Some(parent) = parent_of.get(area) else {
+            continue;
+        };
+        let Some(outer) = plans.get(parent) else {
+            continue;
+        };
+        let leaving_rank = plan.ranks.len().saturating_sub(1);
+        let mut keys = BTreeMap::new();
+        for (edge, border) in &plan.borders {
+            let Some((source, target)) = edges.get(edge) else {
+                continue;
+            };
+            let leaving = plan
+                .ranks
+                .get(leaving_rank)
+                .is_some_and(|rank| rank.contains(border));
+            let other = if leaving { target } else { source };
+            // The other end's element in the parent: the child that holds it, or the parent's own border node.
+            let Some(x) = child_in(parent, other).or_else(|| outer.borders.get(edge).cloned())
+            else {
+                continue;
+            };
+            let chain = outer
+                .chains
+                .iter()
+                .find(|((a, b), _)| (a == area && *b == x) || (*a == x && b == area));
+            let Some(((a, _), dummies)) = chain else {
+                continue;
+            };
+            let next = if a == area {
+                dummies.first().unwrap_or(&x)
+            } else {
+                dummies.last().unwrap_or(&x)
+            };
+            let Some(primary) = relative(outer, next) else {
+                continue;
+            };
+            // Edges that share the next element are ordered by their place at the next container's border.
+            let secondary = plans
+                .get(&x)
+                .and_then(|p| p.borders.get(edge).and_then(|b| relative(p, b)))
+                .unwrap_or(0.5);
+            keys.insert(border.clone(), primary + secondary * 1e-3);
+        }
+        if !keys.is_empty() {
+            out.insert(area.clone(), keys);
+        }
+    }
+    out
+}
+
+/// The pairs of border nodes whose order inside a container disagrees with the order of `keys` (their places outside),
+/// over all its border ranks.
+pub fn border_inversions(plan: &AreaPlan, keys: &BTreeMap<String, f64>) -> usize {
+    let mut total = 0;
+    for rank in &plan.ranks {
+        let ks: Vec<f64> = rank.iter().filter_map(|id| keys.get(id).copied()).collect();
+        for i in 0..ks.len() {
+            for j in i + 1..ks.len() {
+                if ks[i] > ks[j] + 1e-12 {
+                    total += 1;
+                }
+            }
+        }
+    }
+    total
+}
